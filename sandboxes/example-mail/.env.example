# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather
# 1. Open Telegram, message @BotFather
# 2. /newbot then follow prompts
# 3. Copy the API token here
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID (get from @userinfobot)
TELEGRAM_CHAT_ID=

# gogcli keyring password (any string; you choose it during gog auth setup)
GOG_KEYRING_PASSWORD=sandbox

# Your Google account email (the one with the Gmail you want to access)
GOG_ACCOUNT=
